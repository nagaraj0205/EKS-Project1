@@ -3,7 +3,10 @@ kind: Deployment
 metadata:
   name: frontend
 spec:
-  replicas: 1
+  # No `replicas:` here on purpose. The HorizontalPodAutoscaler (hpa.yaml) owns
+  # the replica count. If this field were set, every `kubectl apply` would reset
+  # the HPA's current scale back to this number on each deploy.
+  # The floor and ceiling per environment are minReplicas/maxReplicas in hpa.yaml.
 
   selector:
     matchLabels:
@@ -56,9 +59,42 @@ spec:
               port: http
             initialDelaySeconds: 5
 
+          # The HPA scales on this container's CPU as a percentage of the CPU
+          # *request* below, so the request is the scaling yardstick: 70% of 50m
+          # is 35m per pod. Tune it after a load test. No CPU limit on purpose
+          # (CPU limits throttle nginx and distort the autoscaling signal).
           resources:
             requests:
-              cpu: 25m
+              cpu: 50m
               memory: 64Mi
             limits:
               memory: 192Mi
+
+        # Sidecar that turns nginx's stub_status (served on 127.0.0.1:8080, see
+        # nginx.conf) into Prometheus metrics on :9113. Prometheus scrapes it via
+        # the ServiceMonitor in monitoring/app. It shares the pod's network
+        # namespace, which is why it can reach nginx on localhost.
+        #
+        # Trade-off: a pod is Ready only when ALL its containers are running, so a
+        # crashing exporter would take the pod out of the Service. It is tiny and
+        # stable, but alert on pod restarts (monitoring/app/prometheusrule.yaml).
+        - name: nginx-exporter
+          image: nginx/nginx-prometheus-exporter:1.5.3
+          args:
+            - --nginx.scrape-uri=http://127.0.0.1:8080/stub_status
+          ports:
+            - name: metrics
+              containerPort: 9113
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 10001
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          resources:
+            requests:
+              cpu: 10m
+              memory: 16Mi
+            limits:
+              memory: 64Mi
diff --git a/k8s/base/hpa.yaml b/k8s/base/hpa.yaml
new file mode 100644
index 0000000..d4a3292
--- /dev/null
+++ b/k8s/base/hpa.yaml
@@ -0,0 +1,49 @@
+apiVersion: autoscaling/v2
+kind: HorizontalPodAutoscaler
+metadata:
+  name: frontend
+  labels:
+    app: frontend
+spec:
+  scaleTargetRef:
+    apiVersion: apps/v1
+    kind: Deployment
+    name: frontend
+
+  # Base values suit testing. The prod overlay raises them (min 2, max 6).
+  minReplicas: 1
+  maxReplicas: 2
+
+  metrics:
+    # ContainerResource, not Resource: the pod now has two containers (frontend
+    # and the nginx-exporter sidecar). A plain Resource metric averages across
+    # all containers and would dilute the signal. This looks at `frontend` only.
+    # Needs Kubernetes 1.30+ (beta and on by default from 1.27).
+    - type: ContainerResource
+      containerResource:
+        name: cpu
+        container: frontend
+        target:
+          type: Utilization
+          averageUtilization: 70
+
+  behavior:
+    # Scale up fast: users are waiting.
+    scaleUp:
+      stabilizationWindowSeconds: 0
+      selectPolicy: Max
+      policies:
+        - type: Pods
+          value: 2
+          periodSeconds: 60
+        - type: Percent
+          value: 100
+          periodSeconds: 60
+    # Scale down slowly: wait 5 minutes of low load, then one pod per minute, so a
+    # traffic dip does not cause flapping.
+    scaleDown:
+      stabilizationWindowSeconds: 300
+      policies:
+        - type: Pods
+          value: 1
+          periodSeconds: 60
